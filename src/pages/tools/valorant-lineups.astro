---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLineups, getMap } from '../../data/valorant';

const base = import.meta.env.BASE_URL;
const root = base.endsWith('/') ? base : `${base}/`;
const map = getMap('ascent');
const lineups = getLineups({ mapId: 'ascent' });

if (!map) throw new Error('Ascent map data is missing.');

const mapImage = `${root}${map.image}`;
const mediaUrl = (path: string | undefined) => (path ? `${root}${path}` : undefined);

const serializedLineups = lineups.map((lineup) => ({
  ...lineup,
  media: lineup.media && {
    standImage: mediaUrl(lineup.media.standImage),
    aimImage: mediaUrl(lineup.media.aimImage),
    resultImage: mediaUrl(lineup.media.resultImage),
    videoUrl: lineup.media.videoUrl,
  },
}));
---

<BaseLayout title="Valorant Lineups | Tony Yao">
  <h1>Valorant lineups</h1>
  <p class="intro">Select a map point, then choose one of its available lineup paths.</p>

  <section class="filters" aria-label="Lineup filters">
    <div class="filter-row" aria-label="Map">
      <span class="filter-label">Map</span>
      <button class="filter-button active" type="button" aria-pressed="true">Ascent</button>
    </div>
    <div class="filter-row" aria-label="Side">
      <span class="filter-label">Side</span>
      <button class="filter-button active" type="button" data-side="attack" aria-pressed="true">Attack</button>
      <button class="filter-button" type="button" data-side="defense" aria-pressed="false">Defense</button>
      <button class="filter-button" type="button" data-side="all" aria-pressed="false">All</button>
    </div>
    <div class="filter-row" aria-label="Dart">
      <span class="filter-label">Dart</span>
      <button class="filter-button" type="button" data-utility="shock-dart" aria-pressed="false">Shock</button>
      <button class="filter-button active" type="button" data-utility="recon-dart" aria-pressed="true">Recon</button>
    </div>
  </section>

  <section class="lineup-workspace" aria-label="Lineup workspace">
    <div class="map-panel">
      <section class="lineup-map" aria-label="Ascent lineup map">
        <img src={mapImage} alt="Ascent minimap" />
        <svg id="line-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-label="Available lineup paths"></svg>
        <div id="location-layer"></div>
      </section>
      <p id="map-instructions" class="map-instructions">Choose B Main or B Site to reveal connected routes.</p>
    </div>
    <aside id="lineup-details" class="lineup-details" aria-live="polite">
      <p>Select a map point, then click a lineup path to view its instructions.</p>
    </aside>
  </section>
  <dialog id="image-preview" class="image-preview">
    <button id="close-image-preview" class="close-preview" type="button" aria-label="Close enlarged image">×</button>
    <img id="preview-image" alt="" />
    <p id="preview-caption"></p>
  </dialog>
</BaseLayout>

<script is:inline define:vars={{ map, lineups: serializedLineups }}>
  const locationLayer = document.querySelector('#location-layer');
  const lineLayer = document.querySelector('#line-layer');
  const details = document.querySelector('#lineup-details');
  const instructions = document.querySelector('#map-instructions');
  const imagePreview = document.querySelector('#image-preview');
  const previewImage = document.querySelector('#preview-image');
  const previewCaption = document.querySelector('#preview-caption');
  let selectedLocationId = null;
  let selectedSide = 'attack';
  let selectedUtility = 'recon-dart';

  const filteredLineups = () => lineups.filter((lineup) =>
    (selectedSide === 'all' || lineup.side === selectedSide || lineup.side === 'all') &&
    lineup.utility === selectedUtility,
  );

  const locationById = (id) => map.locations.find((location) => location.id === id);

  function showDetails(lineup) {
    const thumbnail = (source, caption) => source
      ? `<button class="image-thumbnail" type="button" data-image-src="${source}" data-image-caption="${caption}"><img src="${source}" alt="${caption}" /></button>`
      : '';
    const mechanics = `<div class="mechanics-icons" aria-label="${lineup.mechanics.bounces} bounce, ${lineup.mechanics.customChargeNote ?? lineup.mechanics.charge} charge">
      <span class="mechanic"><span class="mechanics-label">Bounce</span><span class="token-row"><i class="token diamond filled"></i><i class="token diamond"></i></span></span>
      <span class="mechanic"><span class="mechanics-label">Charge</span><span class="token-row"><i class="token square filled"></i><i class="token square filled"></i><i class="token square"></i></span></span>
    </div>`;
    details.innerHTML = `
      <h2>${lineup.title}</h2>
      <dl>
        <div><dt>Stand</dt><dd><span>${lineup.stand.description}</span>${thumbnail(lineup.media?.standImage, 'Where to stand')}</dd></div>
        <div><dt>Aim</dt><dd><span>${lineup.aim.description}</span>${thumbnail(lineup.media?.aimImage, 'Where to aim')}</dd></div>
        <div class="mechanics-row"><dd>${mechanics}</dd></div>
        <div><dt>Result</dt><dd><span>${lineup.result}</span>${thumbnail(lineup.media?.resultImage, 'Result')}</dd></div>
      </dl>
      <h3>Notes</h3>
      <ul>${lineup.notes.map((note) => `<li>${note}</li>`).join('')}</ul>`;
  }

  function showPlaceholder(message = 'Select a map point, then click a lineup path to view its instructions.') {
    details.innerHTML = `<p>${message}</p>`;
  }

  function render() {
    const available = filteredLineups();
    locationLayer.innerHTML = '';
    lineLayer.innerHTML = '';

    map.locations.forEach((location) => {
      const isConnected = available.some((lineup) =>
        lineup.startLocationId === location.id || lineup.endLocationId === location.id,
      );
      // Locations with no filtered lineup should not appear on the map at all.
      if (!isConnected) return;

      const button = document.createElement('button');
      button.type = 'button';
      button.className = `map-location ${location.type}${selectedLocationId === location.id ? ' selected' : ''}`;
      button.style.left = `${location.position.x}%`;
      button.style.top = `${location.position.y}%`;
      button.textContent = location.type === 'start' ? 'O' : 'X';
      button.title = `${location.label} (${location.type} position)`;
      button.setAttribute('aria-label', `${location.label} ${location.type} position`);
      button.setAttribute('aria-pressed', String(selectedLocationId === location.id));
      button.addEventListener('click', () => {
        selectedLocationId = location.id;
        showPlaceholder('Click a highlighted lineup path to view its instructions.');
        instructions.textContent = `Routes connected to ${location.label}. Click a line for instructions.`;
        render();
      });
      locationLayer.append(button);
    });

    if (!selectedLocationId) return;

    available
      .filter((lineup) => lineup.startLocationId === selectedLocationId || lineup.endLocationId === selectedLocationId)
      .forEach((lineup) => {
        const start = locationById(lineup.startLocationId);
        const end = locationById(lineup.endLocationId);
        if (!start || !end) return;

        const hitArea = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        const visibleLine = document.createElementNS('http://www.w3.org/2000/svg', 'line');
        [hitArea, visibleLine].forEach((line) => {
          line.setAttribute('x1', start.position.x);
          line.setAttribute('y1', start.position.y);
          line.setAttribute('x2', end.position.x);
          line.setAttribute('y2', end.position.y);
        });
        hitArea.classList.add('lineup-path-hit');
        hitArea.setAttribute('tabindex', '0');
        hitArea.setAttribute('role', 'button');
        hitArea.setAttribute('aria-label', `Open ${lineup.title}`);
        visibleLine.classList.add('lineup-path');
        const open = () => showDetails(lineup);
        hitArea.addEventListener('click', open);
        hitArea.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') open();
        });
        lineLayer.append(hitArea, visibleLine);
      });
  }

  function resetSelection() {
    selectedLocationId = null;
    showPlaceholder();
    instructions.textContent = 'Choose B Main or B Site to reveal connected routes.';
    render();
  }

  document.querySelectorAll('[data-side]').forEach((button) => {
    button.addEventListener('click', () => {
      selectedSide = button.dataset.side;
      document.querySelectorAll('[data-side]').forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle('active', active);
        candidate.setAttribute('aria-pressed', String(active));
      });
      resetSelection();
    });
  });

  document.querySelectorAll('[data-utility]').forEach((button) => {
    button.addEventListener('click', () => {
      selectedUtility = button.dataset.utility;
      document.querySelectorAll('[data-utility]').forEach((candidate) => {
        const active = candidate === button;
        candidate.classList.toggle('active', active);
        candidate.setAttribute('aria-pressed', String(active));
      });
      resetSelection();
    });
  });

  details.addEventListener('click', (event) => {
    const thumbnail = event.target.closest('.image-thumbnail');
    if (!thumbnail) return;
    previewImage.src = thumbnail.dataset.imageSrc;
    previewImage.alt = thumbnail.dataset.imageCaption;
    previewCaption.textContent = thumbnail.dataset.imageCaption;
    imagePreview.showModal();
  });

  document.querySelector('#close-image-preview').addEventListener('click', () => imagePreview.close());
  imagePreview.addEventListener('click', (event) => {
    if (event.target === imagePreview) imagePreview.close();
  });

  render();
</script>

<style>
  .filters { display: grid; gap: 0.8rem; margin: 2rem 0; }
  .filter-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .filter-label { width: 4rem; color: #9caec4; font-weight: 700; }
  .filter-button { min-width: 7rem; border: 1px solid #43546d; border-radius: 999px; padding: 0.55rem 1rem; background: #162235; color: #e5edf7; font: inherit; font-weight: 700; }
  .filter-button.active { border-color: #42a5f5; background: #0f4c81; color: #fff; }
  .lineup-workspace { display: grid; grid-template-columns: minmax(32rem, 1.35fr) minmax(25rem, 0.9fr); gap: 2rem; align-items: start; }
  .map-panel { min-width: 0; }
  .lineup-map { position: relative; width: min(100%, 52rem); aspect-ratio: 1; background: #111; overflow: hidden; }
  .lineup-map > img, #line-layer, #location-layer { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lineup-map > img { object-fit: contain; }
  :global(.lineup-path) { pointer-events: none; stroke: #39d98a; stroke-width: 2.25; vector-effect: non-scaling-stroke; }
  :global(.lineup-path-hit) { pointer-events: stroke; stroke: transparent; stroke-width: 16; vector-effect: non-scaling-stroke; cursor: pointer; }
  :global(.lineup-path-hit:focus) { outline: none; }
  :global(.lineup-path-hit:focus + .lineup-path) { stroke: #facc15; }
  #location-layer { pointer-events: none; }
  :global(.map-location) { position: absolute; width: 2.5rem; height: 2.5rem; transform: translate(-50%, -50%); border: 0; padding: 0; background: transparent; font: 400 2rem/1 system-ui, sans-serif; cursor: pointer; pointer-events: auto; text-shadow: 0 1px 3px #000; }
  :global(.map-location.start) { color: #facc15; }
  :global(.map-location.end) { color: #ef4444; }
  :global(.map-location.selected) { text-shadow: 0 0 0.45rem #fff, 0 1px 3px #000; }
  .map-instructions { font-weight: 600; }
  .lineup-details { min-height: 18rem; padding: 1.5rem; background: #162235; border-left: 4px solid #42a5f5; }
  :global(#lineup-details h2) { margin-top: 0; }
  :global(#lineup-details dl div) { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1rem; margin: 0.8rem 0; }
  :global(#lineup-details dt) { font-weight: 700; }
  :global(#lineup-details dd) { display: flex; align-items: center; gap: 0.75rem; min-width: 0; margin: 0; }
  :global(#lineup-details .mechanics-row) { display: block; margin: 1rem 0; }
  :global(.mechanics-icons) { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  :global(.mechanic) { display: inline-flex; align-items: center; gap: 0.55rem; }
  :global(.mechanics-label) { color: #c8d5e6; font-weight: 700; }
  :global(.token-row) { display: inline-flex; align-items: center; gap: 0.4rem; }
  :global(.token) { display: inline-block; width: 0.75rem; height: 0.75rem; border: 2px solid currentColor; }
  :global(.token.diamond) { color: #facc15; transform: rotate(45deg); }
  :global(.token.square) { color: #7cc4ff; }
  :global(.token.filled) { background: currentColor; }
  :global(.image-thumbnail) { flex: 0 0 18rem; width: 18rem; padding: 0; border: 2px solid transparent; background: transparent; cursor: zoom-in; }
  :global(.image-thumbnail:hover), :global(.image-thumbnail:focus-visible) { border-color: #0f4c81; }
  :global(.image-thumbnail img) { display: block; width: 100%; height: 13.5rem; object-fit: cover; }
  .image-preview { width: min(90vw, 72rem); max-height: 90vh; padding: 1rem; border: 0; background: #101827; color: #fff; }
  .image-preview::backdrop { background: rgb(15 23 42 / 80%); }
  .image-preview img { display: block; width: auto; max-width: 100%; max-height: calc(90vh - 5rem); margin: 0 auto; }
  .image-preview p { margin: 0.6rem 0 0; text-align: center; font-weight: 700; }
  .close-preview { position: absolute; top: 0.25rem; right: 0.5rem; border: 0; background: transparent; color: #fff; font-size: 2rem; line-height: 1; cursor: pointer; }
  @media (max-width: 48rem) {
    .lineup-workspace { grid-template-columns: 1fr; }
    .lineup-map { width: 100%; }
    :global(#lineup-details dl div) { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
